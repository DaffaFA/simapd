REDIS_URL=redis://redis:6379
CAMERA_RTSP_URL=rtsp://user:pass@ip:554/stream
# Development (video file atau mock):
CAMERA_RTSP_URL=/app/test_footage/test.mp4
MOCK_INFERENCE=true
CAMERA_ID=CAM-01
YOLO_MODEL_PATH=models/simapd_yolov8m_sh17_DEPLOY.pt
YOLO_CONFIDENCE=0.45
MOCK_INFERENCE=false
CAPTURES_DIR=/app/captures

# ─── Demo mode (inference dari video file, bukan kamera) ───────────────────
DEMO_MODE=false         # set true untuk demo tanpa kamera fisik
VIDEO_DIR=/app/videos   # folder video di dalam container
DEMO_LOOP=true          # loop semua video setelah selesai
