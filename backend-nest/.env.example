PORT=3001
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=simapd
DATABASE_USER=simapd
DATABASE_PASSWORD=simapd_secret
REDIS_URL=redis://redis:6379
JWT_SECRET=your-very-long-random-secret-here
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# ─── SMTP (kirim Surat Peringatan via email) ────────────────────────────────
# Kosongkan SMTP_HOST untuk menonaktifkan fitur kirim email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SiMAPD <no-reply@simapd.local>
